# Copy this file to .env and fill in what you use. .env is git-ignored.
# Choose the model with PROOFREAD_MODEL here, or with --model on the command line
# (the flag wins). Format: provider:model_name

# --- Google Gemini (default) --------------------------------------------------------
# Key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# PROOFREAD_MODEL=google_genai:gemini-3.6-flash        # best quality (default)
# PROOFREAD_MODEL=google_genai:gemini-3.5-flash-lite   # fastest, cheapest

# --- Ollama (local, free, no key) ---------------------------------------------------
# Install Ollama, then: ollama pull qwen3:8b
# PROOFREAD_MODEL=ollama:qwen3:8b
# OLLAMA_HOST=http://localhost:11434                   # only if Ollama runs elsewhere

# --- OpenAI (optional) --------------------------------------------------------------
# Install: uv sync --extra openai     Key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# PROOFREAD_MODEL=openai:gpt-5.4-mini

# --- Anthropic (optional) -----------------------------------------------------------
# Install: uv sync --extra anthropic  Key: https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=
# PROOFREAD_MODEL=anthropic:claude-haiku-5-5